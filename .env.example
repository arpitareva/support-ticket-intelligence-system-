# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env - it is in .gitignore.
# ---------------------------------------------------------------------------

# LLM provider: groq | ollama | rule_based
#   groq       - free tier, recommended. Get a key at https://console.groq.com
#   ollama     - fully local. Requires `ollama serve` and a pulled model.
#   rule_based - offline keyword planner. No model at all; demo/CI only.
LLM_PROVIDER=groq

# --- Groq -------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama -----------------------------------------------------------------
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434

# --- Data -------------------------------------------------------------------
# CSV_PATH=data/support_tickets.csv
# SQLITE_PATH=data/tickets.db
# REBUILD_DB_ON_STARTUP=true

# --- Anomaly detection ------------------------------------------------------
# Ticket age reference: max_created_at | now | an ISO-8601 timestamp.
# The shipped dataset is historical (Jan-Mar 2024), so `now` would make every
# open ticket years old and the 24h rule meaningless.
# ANOMALY_REFERENCE_TIME=max_created_at
# AGING_THRESHOLD_HOURS=24
# LONG_RESOLUTION_PERCENTILE=95
# SLOW_RESPONSE_PERCENTILE=90
# LOW_RATING_THRESHOLD=2
# MIN_TICKETS_FOR_AGENT_OUTLIER=5

# --- Misc -------------------------------------------------------------------
# API_BASE_URL=http://localhost:8000
# LOG_LEVEL=INFO
# DEFAULT_ROW_LIMIT=25
# MAX_ROW_LIMIT=200
